// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}


// Loyalty points redemption (wallet wali table se alag)
// status: pending      = Mojito ko redeem bheja, jawab ka intezaar
//         active       = points kate, gift card bana, checkout pe laga hai
//         used         = order ban gaya, gift card use ho gaya
//         cancelled    = customer ne Remove kiya, points wapas
//         reversed     = 10 min ping nahi aaya, sweeper ne points wapas kiye
//         failed       = redeem hua hi nahi (points nahi kate)
//         check_needed = pakka pata nahi, haath se check karna hai
model PointsRedemption {
  id                 String   @id @default(cuid())
  shop               String
  customerId         String
  memberId           String
  checkoutToken      String?
  pointsRequested    Int
  pointsRedeemed     Int?
  amountRedeemed     Float?
  billAmount         Float?
  amountToPay        Float?
  status             String   @default("pending")
  invoiceNumber      String?
  approvalCode       String?
  currentBatchNumber String?
  transactionDate    String?
  giftCardId         String?
  giftCardLast4      String?
  lastPingAt         DateTime @default(now())
  reverseAttempts    Int      @default(0)
  errorMessage       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status, lastPingAt])
  @@index([customerId, status])
}
